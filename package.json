  "description": "Локальные GigaAM v3 и whisper.cpp одним плагином для штатного голосового ввода DSH",
  "license": "MIT",
  "author": "NikiMagic",
  "homepage": "https://github.com/nikimagic/dsh-local-stt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikimagic/dsh-local-stt.git"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
