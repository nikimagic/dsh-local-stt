{
  "name": "dsh-local-stt",
  "version": "0.3.12",
  "description": "Локальный ASR для DSH: Whisper NPU по умолчанию и Orukeet Vulkan как альтернатива",
  "license": "MIT",
  "author": "NikiMagic",
  "homepage": "https://github.com/nikimagic/dsh-local-stt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikimagic/dsh-local-stt.git"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.png",
    "docs"
  ],
  "engines": {
    "dsh": "^0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-experimental-speech-to-text": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
